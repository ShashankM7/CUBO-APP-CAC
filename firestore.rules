rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Document ID: authenticated Firebase Auth UID
    // Fields:
    //   uid: string, required, immutable, 20-128 characters
    //   name: string, required, 1-80 characters
    //   email: string, required, immutable, 3-254 characters
    //   theme: string, required, either "light" or "dark"
    //   createdAt: timestamp, required, immutable, server time on create
    //   updatedAt: timestamp, required, server time on every write
    // The document contains private PII and is readable only by its owner.
    // ===============================================================

    // Helper functions
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }
    function uidUnchanged() { return isAuthenticated() && request.resource.data.uid == request.auth.uid; }
    function uidNotModified() { return isAuthenticated() && request.resource.data.uid == resource.data.uid; }
    function isValidEmail(email) { return email is string && email.size() >= 3 && email.size() <= 254 && email.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}$'); }
    // Self-declared metadata only: never grants family roles or age-verified access.
    function validAccountDetails(data) {
      return data is map
        && data.keys().hasAll(['birthDate', 'phoneNumber', 'accountType', 'ageVerification', 'phoneVerification', 'guardianStatus'])
        && data.keys().hasOnly(['birthDate', 'phoneNumber', 'accountType', 'ageVerification', 'phoneVerification', 'guardianStatus'])
        && data.birthDate is string && data.birthDate.size() == 10
        && data.birthDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && data.phoneNumber is string && data.phoneNumber.size() >= 9 && data.phoneNumber.size() <= 16
        && data.phoneNumber.matches('^[+][1-9][0-9]{7,14}$')
        && data.accountType in ['minor', 'adult']
        && data.ageVerification == 'self-declared'
        && data.phoneVerification == 'unverified'
        && data.guardianStatus == 'not-linked';
    }
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'theme', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'theme', 'createdAt', 'updatedAt', 'accountDetails'])
        && data.uid is string && data.uid.size() >= 20 && data.uid.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && isValidEmail(data.email)
        && data.theme is string && data.theme in ['light', 'dark']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('accountDetails' in data) || validAccountDetails(data.accountDetails));
    }
    function isValidSyncDocument(domain, data) {
      return domain in ['vehicles', 'places', 'insurance', 'blockedApps', 'drives', 'assistant']
        && data.keys().hasAll(['schemaVersion', 'payload', 'updatedAt'])
        && data.keys().hasOnly(['schemaVersion', 'payload', 'updatedAt'])
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.payload is string
        && ((domain == 'vehicles' && data.payload.size() <= 60000)
          || (domain == 'places' && data.payload.size() <= 80000)
          || (domain == 'insurance' && data.payload.size() <= 20000)
          || (domain == 'blockedApps' && data.payload.size() <= 120000)
          || (domain == 'drives' && data.payload.size() <= 700000)
          || (domain == 'assistant' && data.payload.size() <= 500000))
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && uidUnchanged() && isValidUser(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(userId) && uidNotModified() && isValidUser(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.email == resource.data.email || request.auth.token.email_verified == true)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      // Bounded JSON envelopes keep account sync inexpensive and make it
      // impossible for one signed-in account to read or overwrite another.
      match /sync/{domain} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidSyncDocument(domain, request.resource.data);
        allow delete: if false;
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
